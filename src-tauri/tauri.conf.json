{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Pilo",
	"identifier": "app.hsingjui.pilo",
	"build": {
		"beforeDevCommand": "pnpm exec vite",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Pilo",
				"decorations": true,
				"create": false,
				"visible": false,
				"dragDropEnabled": false,
				"width": 1200,
				"height": 800,
				"minWidth": 768,
				"minHeight": 600,
				"center": true,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay",
				"trafficLightPosition": { "x": 20.0, "y": 25.0 }
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "DeveloperTool",
		"shortDescription": "A simple desktop client for Pi Coding Agent",
		"longDescription": "A simple desktop client for Pi Coding Agent that brings Local, WSL, and SSH projects into one workspace while keeping Pi in the environment where the code lives.",
		"homepage": "https://github.com/gaoxiang89/pilo",
		"linux": {
			"deb": {
				"desktopTemplate": "linux/pilo.desktop"
			},
			"rpm": {
				"desktopTemplate": "linux/pilo.desktop"
			}
		},
		"createUpdaterArtifacts": true,
		"resources": {
			"resources/": "runtime/",
			"icons/128x128.png": "icons/128x128.png"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5MjJBRjdFNkY5MDA2RUIKUldUckJwQnZmcThpS1lxUGoybTE2VHBHZU8yM1JpdE5wSlN6aVh3VVhOcFhIakdpQTBWUWpwb3oK",
			"endpoints": [
				"https://github.com/gaoxiang89/pilo/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
